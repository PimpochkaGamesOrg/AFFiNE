# Local image tag produced by scripts/selfhost-build.sh on this VPS
AFFINE_IMAGE=pimpochka/affine:latest

PORT=3010

# All data under the install directory (e.g. /opt/affine/data/...)
DB_DATA_LOCATION=./data/postgres
UPLOAD_LOCATION=./data/storage
CONFIG_LOCATION=./data/config

AFFINE_SELFHOST_MEMBER_LIMIT=100

DB_USERNAME=affine
DB_PASSWORD=change-me
DB_DATABASE=affine
